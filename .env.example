DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=ayurveda_traceability
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Supabase PostgreSQL URL takes precedence over the POSTGRES_* settings above.
# Paste the connection URI from Supabase; use sslmode=require.
SUPABASE_DATABASE_URL=
# Use "transaction" only when using Supabase's transaction pooler.
SUPABASE_DB_POOLER=session
DB_CONN_MAX_AGE=60

# Configure a private bucket in Supabase Storage and use its S3 credentials.
# Find the exact endpoint and region in Supabase Storage > S3 configuration.
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

MEDIA_URL=/upload/
PRODUCT_VERIFICATION_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=
API_ANON_THROTTLE=30/minute
API_USER_THROTTLE=120/minute
